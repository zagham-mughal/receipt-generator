# Copy to .env and fill in. .env is git-ignored — never commit real values.
# Keep values single-quoted. Generate them with the commands shown.

# Password for the "admin" login. Generate: openssl rand -hex 24
ADMIN_PASSWORD='change-me'

# Signs session cookies. 32+ characters, required in production. Generate: openssl rand -hex 32
SESSION_SECRET='change-me-to-a-random-string-of-at-least-32-characters'
